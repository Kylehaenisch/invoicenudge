# --- Supabase (Settings -> API in your Supabase project) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (resend.com/api-keys) -------------------------------------------
RESEND_API_KEY=
# Must be on a domain you've verified in Resend for anything beyond testing.
REMINDER_FROM_EMAIL="InvoiceNudge <reminders@yourdomain.com>"

# --- Stripe (dashboard.stripe.com/apikeys) ----------------------------------
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen`) locally, or the webhook's settings page in prod.
STRIPE_WEBHOOK_SECRET=

# --- App ---------------------------------------------------------------------
# No trailing slash. Used to build the client-facing invoice links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret Vercel Cron sends back as `Authorization: Bearer <value>` —
# set the same value here and as a Vercel project env var.
CRON_SECRET=

# --- Seed script (scripts/seed.ts) — optional, has defaults -----------------
# SEED_EMAIL=demo@invoicenudge.test
# SEED_PASSWORD=demo12345
# SEED_BUSINESS_NAME="Kyle Haenisch Photography"
